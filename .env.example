# Copia este archivo a ".env" y cambia los valores antes de correr la app.
# El archivo ".env" real NUNCA se sube a git (ya esta en .gitignore).

APP_NAME=Electroplast - Inspecciones Monta Cargas
ENVIRONMENT=local

# --- Base de datos ---
# Local (por defecto, no requiere nada instalado): SQLite en un archivo.
DATABASE_URL=sqlite:///./data/app.db

# Produccion (Supabase): ve a tu proyecto en supabase.com -> Connect ->
# "Connection string" -> URI. Usa el modo "Session pooler" (puerto 6543)
# si vas a desplegar en Render/Railway; copia esa cadena y cambiale el
# prefijo "postgresql://" por "postgresql+psycopg://". Ejemplo:
# DATABASE_URL=postgresql+psycopg://postgres.xxxxxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
